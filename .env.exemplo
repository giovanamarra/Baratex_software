# Modelo do arquivo .env do Comparador de Catálogos.
# Copie este arquivo para .env, na mesma pasta, e preencha. O .env nunca vai para o git.
# Uma linha por valor, no formato NOME=valor. Linhas começando com # são comentários.

# Chave secreta da instalação. Gere uma com o comando do README (seção "Instalar") e cole aqui.
SECRET_KEY=troque-por-uma-chave-gerada

# Pasta onde ficam os arquivos dos Catálogos, as imagens de página e as fotos.
# Fica fora da pasta do programa. Exemplos:
#   Windows: PASTA_DE_ARQUIVOS=C:\Users\gestora\ComparadorDeCatalogos\arquivos
#   macOS:   PASTA_DE_ARQUIVOS=/Users/gestora/ComparadorDeCatalogos/arquivos
# Sem esta linha, o sistema usa ComparadorDeCatalogos/arquivos dentro da pasta do usuário.
PASTA_DE_ARQUIVOS=

# Chave da API da LLM (Claude). Opcional: só é necessária para ler Catálogos pela LLM.
ANTHROPIC_API_KEY=

# Deixe False na instalação da gestora. True só para quem programa investigar um erro.
DEBUG=False
